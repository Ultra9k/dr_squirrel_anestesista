<!DOCTYPE html>

<html lang="pt">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<title>Dr. Squirrel – Anestesista</title>
<style>
  * { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }
  body {
    background:#0b1a2e;
    display:flex; flex-direction:column;
    align-items:center; justify-content:center;
    height:100dvh; overflow:hidden;
    font-family:'Courier New',monospace;
    touch-action:none;
  }
  #gameContainer {
    position:relative; display:flex; flex-direction:column;
    align-items:center; width:100%; height:100dvh;
  }
  #hud {
    display:flex; justify-content:space-between; align-items:center;
    width:100%; max-width:480px; padding:6px 14px;
    flex-shrink:0;
  }
  .hud-item { display:flex; flex-direction:column; align-items:center; }
  .hud-label { color:#7ecfff; font-size:9px; letter-spacing:2px; text-transform:uppercase; }
  .hud-val   { color:#fff; font-size:15px; font-weight:bold; letter-spacing:1px; }
  #lives-display { display:flex; gap:3px; align-items:center; }
  .heart { font-size:16px; }
  #ammo-display { display:flex; gap:2px; align-items:center; flex-wrap:wrap; max-width:100px; justify-content:flex-end; }
  .syringe-icon { font-size:13px; }
  canvas {
    border-radius:8px;
    box-shadow:0 0 40px rgba(0,200,255,0.12), 0 0 0 1px rgba(255,255,255,0.06);
    image-rendering:pixelated;
    flex-shrink:1; max-width:480px; width:100%;
  }
  #controls {
    display:flex; justify-content:space-between; align-items:center;
    width:100%; max-width:480px; padding:4px 12px 10px;
    flex-shrink:0;
  }
  .ctrl-group { display:flex; gap:8px; }
  .btn {
    width:60px; height:60px;
    background:rgba(255,255,255,0.06);
    border:2px solid rgba(255,255,255,0.12);
    border-radius:14px; color:#fff; font-size:20px;
    display:flex; align-items:center; justify-content:center;
    cursor:pointer; user-select:none; -webkit-user-select:none;
    transition:background .1s, transform .05s;
  }
  .btn:active,.btn.pressed {
    background:rgba(0,200,255,0.25); border-color:rgba(0,200,255,0.5);
    transform:scale(0.94);
  }
  #btn-shoot {
    background:rgba(126,207,255,0.12); border-color:rgba(126,207,255,0.35); font-size:22px;
  }
  #btn-shoot:active,#btn-shoot.pressed {
    background:rgba(126,207,255,0.4); border-color:rgba(126,207,255,0.8);
  }
  #btn-jump {
    width:68px; height:68px;
    background:rgba(255,200,50,0.1); border-color:rgba(255,200,50,0.3); font-size:24px;
  }
  #btn-jump:active,#btn-jump.pressed {
    background:rgba(255,200,50,0.35); border-color:rgba(255,200,50,0.7);
  }
  #overlay {
    position:absolute; top:0; left:0; width:100%; height:100%;
    display:flex; flex-direction:column;
    align-items:center; justify-content:center; gap:12px;
    background:rgba(8,16,30,0.93); z-index:10;
    backdrop-filter:blur(6px);
  }
  #overlay h1 { font-size:26px; color:#fff; letter-spacing:4px; text-shadow:0 0 24px rgba(0,200,255,0.9); text-align:center; line-height:1.35; }
  .sub { font-size:11px; color:#7ecfff; letter-spacing:2px; text-transform:uppercase; text-align:center; }
  .tip { font-size:12px; color:#ccc; text-align:center; max-width:280px; line-height:1.7; }
  .start-btn {
    margin-top:6px; padding:13px 36px;
    background:linear-gradient(135deg,#00b4d8,#0077b6);
    border:none; border-radius:40px; color:#fff;
    font-size:15px; font-family:'Courier New',monospace;
    letter-spacing:3px; text-transform:uppercase; cursor:pointer;
    box-shadow:0 4px 24px rgba(0,180,216,0.45);
    transition:transform .1s;
  }
  .start-btn:active { transform:scale(0.96); }
  .pixel-art { font-size:52px; animation:float 2s ease-in-out infinite; }
  @keyframes float { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-10px)} }
  .score-big { font-size:26px; color:#7ecfff; letter-spacing:3px; }
</style>
</head>
<body>
<div id="gameContainer">
  <div id="hud">
    <div class="hud-item">
      <div class="hud-label">Pontos</div>
      <div class="hud-val" id="score-display">0</div>
    </div>
    <div class="hud-item">
      <div class="hud-label">Nível</div>
      <div class="hud-val" id="level-display">1</div>
    </div>
    <div class="hud-item" id="lives-display"></div>
    <div class="hud-item" style="align-items:flex-end">
      <div class="hud-label">Propofol</div>
      <div id="ammo-display"></div>
    </div>
  </div>

<canvas id="c"></canvas>

  <div id="controls">
    <div class="ctrl-group">
      <div class="btn" id="btn-left">◀</div>
      <div class="btn" id="btn-right">▶</div>
    </div>
    <div class="ctrl-group">
      <div class="btn" id="btn-shoot">💉</div>
      <div class="btn" id="btn-jump">▲</div>
    </div>
  </div>

  <div id="overlay">
    <div class="pixel-art">🐿️</div>
    <h1>DR. SQUIRREL<br>ANESTESISTA</h1>
    <div class="sub">O Esquilo que Adormece Tudo</div>
    <div class="tip">
      💉 Apanha seringas de propofol pelo mapa<br>
      Dispara nos doentes para os adormecer<br>
      Pisa os doentes a dormir para pontuar!
    </div>
    <button class="start-btn" onclick="startGame()">COMEÇAR CIRURGIA</button>
  </div>
</div>

<script>
const canvas = document.getElementById('c');
const ctx = canvas.getContext('2d');

function resize() {
  const container = document.getElementById('gameContainer');
  const hud = document.getElementById('hud');
  const controls = document.getElementById('controls');
  const avail = container.clientHeight - hud.clientHeight - controls.clientHeight - 16;
  const w = Math.min(container.clientWidth, 480);
  const h = Math.min(avail, 390);
  canvas.width = Math.floor(w);
  canvas.height = Math.floor(h);
  canvas.style.width = w + 'px';
  canvas.style.height = h + 'px';
}
window.addEventListener('resize', () => { resize(); if (gameState === 'playing') initLevel(); });
resize();

let gameState = 'menu';
let score = 0, lives = 3, level = 1, ammo = 5;
const MAX_AMMO = 8;
let keys = { left:false, right:false, jump:false, shoot:false };
let jumpPressed = false, shootPressed = false;
const GRAV = 0.44, JUMP_VEL = -11, SPEED = 3.4;

let player, platforms, syringes, enemies, bullets, particles, camera;

function updateHUD() {
  document.getElementById('score-display').textContent = score;
  document.getElementById('level-display').textContent = level;
  const h = document.getElementById('lives-display');
  h.innerHTML = '';
  for (let i = 0; i < 3; i++) {
    const s = document.createElement('span');
    s.className = 'heart';
    s.textContent = i < lives ? '❤️' : '🖤';
    h.appendChild(s);
  }
  const a = document.getElementById('ammo-display');
  a.innerHTML = '';
  for (let i = 0; i < MAX_AMMO; i++) {
    const s = document.createElement('span');
    s.className = 'syringe-icon';
    s.textContent = i < ammo ? '💉' : '·';
    a.appendChild(s);
  }
}

function initLevel() {
  const W = canvas.width, H = canvas.height;
  const worldW = W * 3.2;
  camera = { x: 0 };

  player = {
    x: 60, y: H - 120, w: 28, h: 36,
    vx: 0, vy: 0, onGround: false, jumpsLeft: 2,
    facing: 1, frame: 0, frameTimer: 0,
    invincible: 0, reached: false,
    goalX: worldW - 80
  };

  const gY = H - 40;
  platforms = [
    { x: 0,            y: gY, w: worldW * 0.28, h: 40, type: 'ground' },
    { x: worldW * 0.33, y: gY, w: worldW * 0.22, h: 40, type: 'ground' },
    { x: worldW * 0.62, y: gY, w: worldW * 0.38, h: 40, type: 'ground' },
  ];
  const floats = [
    {x:130,y:gY-85},{x:270,y:gY-140},{x:410,y:gY-88},
    {x:560,y:gY-160},{x:700,y:gY-110},{x:840,y:gY-150},
    {x:980,y:gY-90},{x:1100,y:gY-175},{x:1240,y:gY-120},
    {x:1370,y:gY-85},{x:1490,y:gY-165},{x:1630,y:gY-105},
    {x:1770,y:gY-145},{x:1920,y:gY-85},
  ];
  floats.forEach(p => platforms.push({ x: p.x, y: p.y, w: 88 + Math.random() * 40, h: 16, type: 'platform' }));

  syringes = [];
  platforms.forEach(p => {
    if (p.type === 'platform') {
      const n = 1 + Math.floor(Math.random() * 2);
      for (let j = 0; j < n; j++)
        syringes.push({ x: p.x + 14 + j * 28, y: p.y - 24, w: 14, h: 22, collected: false, anim: Math.random() * Math.PI * 2 });
    }
  });
  for (let i = 0; i < 8; i++)
    syringes.push({ x: 90 + i * 100, y: gY - 24, w: 14, h: 22, collected: false, anim: Math.random() * Math.PI * 2 });

  enemies = [];
  const count = 3 + level * 2;
  for (let i = 0; i < count; i++) {
    const p = platforms[Math.floor(Math.random() * platforms.length)];
    const spd = (0.7 + Math.random() * 0.7) * (level >= 3 ? 1.35 : 1);
    enemies.push({
      x: p.x + 12, y: p.y - 38, w: 26, h: 38,
      vx: spd, vy: 0, onGround: false,
      minX: p.x + 4, maxX: p.x + p.w - 30,
      frame: 0, frameTimer: 0,
      alive: true, asleep: false, sleepTimer: 0
    });
  }

  bullets = [];
  particles = [];
}

function spawnParticles(x, y, color, n) {
  n = n || 8;
  for (let i = 0; i < n; i++) {
    const a = (Math.PI * 2 / n) * i + Math.random() * 0.5;
    particles.push({
      x, y,
      vx: Math.cos(a) * (2 + Math.random() * 3),
      vy: Math.sin(a) * (2 + Math.random() * 3) - 2,
      life: 1, color: color || '#7ecfff', size: 4 + Math.random() * 4,
      isZzz: false
    });
  }
}

function rectOverlap(a, b) {
  return a.x < b.x + b.w && a.x + a.w > b.x && a.y < b.y + b.h && a.y + a.h > b.y;
}

function shoot() {
  if (ammo <= 0) return;
  ammo--;
  updateHUD();
  bullets.push({
    x: player.x + (player.facing === 1 ? player.w + 2 : -20),
    y: player.y + player.h * 0.35,
    vx: player.facing * 10,
    vy: 0, life: 1, w: 18, h: 7
  });
  spawnParticles(player.x + player.w / 2, player.y + player.h * 0.35, '#7ecfff', 4);
}

function resolvePlayerPlatforms() {
  player.onGround = false;
  platforms.forEach(p => {
    if (!rectOverlap(player, p)) return;
    const oB = (player.y + player.h) - p.y;
    const oT = (p.y + p.h) - player.y;
    const oL = (player.x + player.w) - p.x;
    const oR = (p.x + p.w) - player.x;
    const m = Math.min(oB, oT, oL, oR);
    if (m === oB && player.vy >= 0) { player.y = p.y - player.h; player.vy = 0; player.onGround = true; player.jumpsLeft = 2; }
    else if (m === oT && player.vy < 0) { player.y = p.y + p.h; player.vy = 0; }
    else if (m === oL) { player.x = p.x - player.w; player.vx = 0; }
    else if (m === oR) { player.x = p.x + p.w; player.vx = 0; }
  });
}

function updatePlayer() {
  const W = canvas.width, H = canvas.height;
  const worldW = W * 3.2;

  if (keys.left)  { player.vx -= 0.8; player.facing = -1; }
  else if (keys.right) { player.vx += 0.8; player.facing = 1; }
  else player.vx *= 0.78;
  player.vx = Math.max(-SPEED, Math.min(SPEED, player.vx));

  if (keys.jump && !jumpPressed && player.jumpsLeft > 0) {
    player.vy = JUMP_VEL + (player.jumpsLeft < 2 ? 1 : 0);
    player.jumpsLeft--;
    jumpPressed = true;
    spawnParticles(player.x + player.w / 2, player.y + player.h, '#aaffc4', 5);
  }
  if (!keys.jump) jumpPressed = false;

  if (keys.shoot && !shootPressed) { shoot(); shootPressed = true; }
  if (!keys.shoot) shootPressed = false;

  player.vy += GRAV;
  player.vy = Math.min(player.vy, 14);
  player.x += player.vx;
  player.y += player.vy;
  resolvePlayerPlatforms();

  player.x = Math.max(0, Math.min(worldW - player.w, player.x));
  if (player.y > H + 120) { loseLife(); return; }

  camera.x = player.x - W * 0.35;
  camera.x = Math.max(0, Math.min(worldW - W, camera.x));

  syringes.forEach(s => {
    if (s.collected) return;
    s.anim += 0.06;
    if (rectOverlap(player, s)) {
      s.collected = true;
      ammo = Math.min(MAX_AMMO, ammo + 1);
      score += 5;
      spawnParticles(s.x + s.w / 2, s.y + s.h / 2, '#7ecfff', 6);
      updateHUD();
    }
  });

  if (player.invincible <= 0) {
    enemies.forEach(e => {
      if (!e.alive || !rectOverlap(player, e)) return;
      if (e.asleep) {
        if (player.vy > 0.5 && player.y + player.h < e.y + e.h * 0.65) {
          e.alive = false;
          player.vy = JUMP_VEL * 0.55;
          score += 80;
          spawnParticles(e.x + e.w / 2, e.y, '#ffe04b', 10);
          updateHUD();
        }
      } else {
        if (player.vy > 1 && player.y + player.h < e.y + e.h * 0.6) {
          e.asleep = true; e.sleepTimer = 200 + level * 30; e.vx = 0;
          player.vy = JUMP_VEL * 0.5;
          score += 30;
          spawnParticles(e.x + e.w / 2, e.y, '#a8d8ea', 8);
          updateHUD();
        } else {
          loseLife();
        }
      }
    });
  }
  if (player.invincible > 0) player.invincible--;

  if (Math.abs(player.vx) > 0.3 && player.onGround) {
    player.frameTimer++;
    if (player.frameTimer > 7) { player.frame = (player.frame + 1) % 4; player.frameTimer = 0; }
  } else if (!player.onGround) player.frame = 1;
  else player.frame = 0;

  if (!player.reached && player.x + player.w > player.goalX) {
    player.reached = true;
    score += 120 * level;
    updateHUD();
    setTimeout(() => { level++; ammo = Math.min(MAX_AMMO, ammo + 3); updateHUD(); initLevel(); }, 1300);
  }
}

function updateBullets() {
  const W = canvas.width;
  bullets = bullets.filter(b => b.life > 0 && b.x > camera.x - 40 && b.x < camera.x + W + 40);
  bullets.forEach(b => {
    b.x += b.vx;
    b.y += b.vy;
    b.vy += 0.08;
    let hitWall = false;
    platforms.forEach(p => { if (rectOverlap(b, p)) hitWall = true; });
    if (hitWall) { b.life = 0; spawnParticles(b.x, b.y, '#7ecfff', 4); return; }
    enemies.forEach(e => {
      if (!e.alive || e.asleep || b.life <= 0) return;
      if (rectOverlap(b, e)) {
        b.life = 0;
        e.asleep = true; e.sleepTimer = 220 + level * 25; e.vx = 0;
        score += 40;
        spawnParticles(e.x + e.w / 2, e.y + e.h / 2, '#a8d8ea', 12);
        updateHUD();
        for (let i = 0; i < 4; i++) particles.push({
          x: e.x + e.w / 2, y: e.y - 6,
          vx: (Math.random() - 0.5) * 1.5, vy: -1 - Math.random() * 0.8,
          life: 1.2, color: '#fff', size: 8 + i * 2, isZzz: true, letter: 'z'.repeat(i + 1)
        });
      }
    });
  });
}

function updateEnemies() {
  enemies.forEach(e => {
    if (!e.alive) return;
    if (e.asleep) {
      e.sleepTimer--;
      e.vy += GRAV; e.y += e.vy;
      platforms.forEach(p => {
        if (rectOverlap(e, p)) {
          const oB = (e.y + e.h) - p.y;
          if (oB < e.h * 0.9 && e.vy >= 0) { e.y = p.y - e.h; e.vy = 0; }
        }
      });
      if (e.sleepTimer <= 0) {
        e.asleep = false;
        e.vx = (Math.random() > 0.5 ? 1 : -1) * (0.7 + Math.random() * 0.7) * (level >= 3 ? 1.3 : 1);
        spawnParticles(e.x + e.w / 2, e.y, '#ffcf77', 5);
      }
      return;
    }
    e.x += e.vx; e.vy += GRAV; e.y += e.vy;
    platforms.forEach(p => {
      if (rectOverlap(e, p)) {
        const oB = (e.y + e.h) - p.y;
        if (oB < e.h * 0.9 && e.vy >= 0) { e.y = p.y - e.h; e.vy = 0; e.onGround = true; }
      }
    });
    if (e.x <= e.minX || e.x + e.w >= e.maxX) e.vx *= -1;
    e.frameTimer++; if (e.frameTimer > 10) { e.frame = (e.frame + 1) % 2; e.frameTimer = 0; }
  });
}

function updateParticles() {
  particles = particles.filter(p => p.life > 0);
  particles.forEach(p => {
    p.x += p.vx; p.y += p.vy;
    if (!p.isZzz) p.vy += 0.15;
    p.life -= 0.04; p.size *= 0.96;
  });
}

function loseLife() {
  lives--;
  updateHUD();
  spawnParticles(player.x + player.w / 2, player.y + player.h / 2, '#ff6b6b', 10);
  if (lives <= 0) { gameOver(); return; }
  player.invincible = 90; player.x = 60; player.y = canvas.height - 150; player.vx = 0; player.vy = 0;
}

function gameOver() {
  gameState = 'gameover';
  const ov = document.getElementById('overlay');
  ov.innerHTML = `
    <div class="pixel-art">🏥</div>
    <h1 style="font-size:24px">FIM DA CIRURGIA</h1>
    <div class="score-big">💉 ${score} pts</div>
    <div class="sub">Nível ${level} &middot; ${score} pontos</div>
    <button class="start-btn" onclick="startGame()">NOVA CIRURGIA</button>`;
  ov.style.display = 'flex';
}

/* ══════════════ DRAW ══════════════ */
function drawBackground() {
  const W = canvas.width, H = canvas.height;
  const g = ctx.createLinearGradient(0, 0, 0, H);
  g.addColorStop(0, '#0b1a2e'); g.addColorStop(1, '#0e2240');
  ctx.fillStyle = g; ctx.fillRect(0, 0, W, H);

  ctx.strokeStyle = 'rgba(100,180,255,0.04)'; ctx.lineWidth = 1;
  for (let x = 0; x < W; x += 32) { ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, H); ctx.stroke(); }
  for (let y = 0; y < H; y += 32) { ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(W, y); ctx.stroke(); }

  ctx.save();
  ctx.fillStyle = 'rgba(255,255,255,0.07)';
  ctx.font = 'bold 26px sans-serif'; ctx.textAlign = 'center';
  ctx.fillText('🏥', W - 44, 46);
  ctx.restore();

  ctx.save();
  ctx.translate(-camera.x * 0.18, 0);
  ctx.fillStyle = 'rgba(14,34,64,0.55)';
  [[0,H-100,220,90],[250,H-80,260,80],[560,H-110,200,100],[820,H-90,240,85],[1100,H-105,210,95]].forEach(([x,y,w,h]) => {
    ctx.beginPath(); ctx.ellipse(x + w/2, y + h, w/2, h/2, 0, Math.PI, 2 * Math.PI); ctx.fill();
  });
  ctx.restore();
}

function drawPlatforms() {
  platforms.forEach(p => {
    const x = p.x - camera.x;
    if (x + p.w < 0 || x > canvas.width) return;
    if (p.type === 'ground') {
      ctx.fillStyle = '#1c3d5a'; ctx.fillRect(x, p.y + 6, p.w, p.h - 6);
      ctx.fillStyle = '#245073'; ctx.fillRect(x, p.y, p.w, 8);
      ctx.fillStyle = '#2e6a94'; ctx.fillRect(x, p.y, p.w, 3);
      ctx.strokeStyle = 'rgba(255,255,255,0.05)'; ctx.lineWidth = 1;
      for (let i = 24; i < p.w; i += 24) { ctx.beginPath(); ctx.moveTo(x + i, p.y); ctx.lineTo(x + i, p.y + p.h); ctx.stroke(); }
    } else {
      ctx.fillStyle = '#1a3a5a'; ctx.fillRect(x, p.y + 4, p.w, p.h - 4);
      ctx.fillStyle = '#e8f4fd'; ctx.fillRect(x, p.y, p.w, 5);
      ctx.fillStyle = 'rgba(200,230,255,0.5)'; ctx.fillRect(x, p.y + 5, p.w, 3);
    }
  });
}

function drawSyringe(s) {
  if (s.collected) return;
  const x = s.x - camera.x;
  if (x < -20 || x > canvas.width + 20) return;
  const bob = Math.sin(s.anim) * 3;
  const y = s.y + bob;
  ctx.save();
  ctx.shadowColor = '#7ecfff'; ctx.shadowBlur = 10 + Math.abs(Math.sin(s.anim)) * 8;
  ctx.fillStyle = 'rgba(200,235,255,0.92)';
  ctx.fillRect(x + 2, y + 5, s.w - 4, s.h - 8);
  ctx.strokeStyle = 'rgba(100,180,255,0.8)'; ctx.lineWidth = 1.5;
  ctx.strokeRect(x + 2, y + 5, s.w - 4, s.h - 8);
  ctx.fillStyle = 'rgba(150,210,255,0.65)';
  ctx.fillRect(x + 3, y + 7, s.w - 6, s.h - 12);
  ctx.fillStyle = '#3a7fbf';
  ctx.fillRect(x + 3, y + 3, s.w - 6, 4);
  ctx.fillRect(x + 5, y, 4, 5);
  ctx.fillStyle = '#aad4f5';
  ctx.fillRect(x + s.w / 2 - 1, y + s.h - 4, 2, 5);
  ctx.fillStyle = '#ff6b6b';
  ctx.fillRect(x + s.w / 2 - 3, y + s.h * 0.5, 6, 2);
  ctx.fillRect(x + s.w / 2 - 1, y + s.h * 0.5 - 2, 2, 6);
  ctx.restore();
}

function drawBullets() {
  bullets.forEach(b => {
    if (b.life <= 0) return;
    const x = b.x - camera.x;
    ctx.save();
    ctx.shadowColor = '#7ecfff'; ctx.shadowBlur = 14;
    const angle = Math.atan2(b.vy, b.vx);
    ctx.translate(x + b.w / 2, b.y + b.h / 2);
    ctx.rotate(angle);
    ctx.fillStyle = 'rgba(180,230,255,0.95)';
    ctx.fillRect(-b.w / 2, -b.h / 2, b.w, b.h);
    ctx.fillStyle = 'rgba(100,180,255,0.9)';
    ctx.fillRect(-b.w / 2, -b.h / 2, b.w * 0.3, b.h);
    ctx.fillStyle = 'rgba(200,240,255,0.7)';
    ctx.fillRect(b.w / 2 - 4, -1, 4, 2);
    ctx.restore();
  });
}

function drawEnemy(e) {
  if (!e.alive) return;
  const x = e.x - camera.x;
  if (x + e.w < 0 || x > canvas.width) return;
  const bob = e.asleep ? 2 : (e.frame === 0 ? 0 : 2);
  const ey = e.y + (e.asleep ? 4 : 0);

  ctx.save();
  if (e.asleep) ctx.globalAlpha = 0.87;

  ctx.fillStyle = e.asleep ? '#a8d8ea' : '#e8f4fd';
  ctx.fillRect(x + 2, ey + 12 + bob, e.w - 4, e.h - 12);

  ctx.fillStyle = 'rgba(100,160,200,0.22)';
  for (let r = 0; r < 3; r++) for (let c = 0; c < 2; c++)
    ctx.fillRect(x + 5 + c * 10, ey + 16 + r * 8 + bob, 3, 3);

  ctx.fillStyle = '#f9dfc0';
  ctx.beginPath(); ctx.roundRect(x + 3, ey - 2 + bob, e.w - 6, 16, [6]); ctx.fill();

  ctx.fillStyle = '#8B6914';
  ctx.fillRect(x + 3, ey - 7 + bob, e.w - 6, 7);
  ctx.fillRect(x + 1, ey - 5 + bob, 4, 5); ctx.fillRect(x + e.w - 5, ey - 5 + bob, 4, 5);

  if (e.asleep) {
    ctx.strokeStyle = '#555'; ctx.lineWidth = 1.5;
    ctx.beginPath(); ctx.moveTo(x + 7, ey + 4 + bob); ctx.lineTo(x + 11, ey + 4 + bob); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(x + e.w - 11, ey + 4 + bob); ctx.lineTo(x + e.w - 7, ey + 4 + bob); ctx.stroke();
    ctx.fillStyle = '#c0392b';
    ctx.beginPath(); ctx.ellipse(x + e.w / 2, ey + 9 + bob, 3, 2, 0, 0, Math.PI); ctx.fill();
  } else {
    ctx.fillStyle = '#fff';
    ctx.fillRect(x + 6, ey + 2 + bob, 6, 6); ctx.fillRect(x + e.w - 12, ey + 2 + bob, 6, 6);
    ctx.fillStyle = '#1a6fa8';
    ctx.fillRect(x + 8, ey + 3 + bob, 3, 3); ctx.fillRect(x + e.w - 10, ey + 3 + bob, 3, 3);
    ctx.strokeStyle = '#8B6914'; ctx.lineWidth = 1.5;
    ctx.beginPath(); ctx.moveTo(x + 6, ey + 1 + bob); ctx.lineTo(x + 12, ey + 3 + bob); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(x + e.w - 6, ey + 1 + bob); ctx.lineTo(x + e.w - 12, ey + 3 + bob); ctx.stroke();
    ctx.fillStyle = '#c0392b';
    ctx.beginPath(); ctx.ellipse(x + e.w / 2, ey + 9 + bob, 3, 3, 0, 0, Math.PI * 2); ctx.fill();
  }

  ctx.fillStyle = 'rgba(150,180,200,0.45)';
  ctx.fillRect(x + e.w - 4, ey - 14 + bob, 2, e.h + 12);
  ctx.fillStyle = 'rgba(180,220,255,0.55)';
  ctx.beginPath(); ctx.arc(x + e.w - 3, ey - 14 + bob, 4, 0, Math.PI * 2); ctx.fill();

  ctx.restore();

  if (e.asleep && e.sleepTimer > 0) {
    const phase = Math.floor(e.sleepTimer / 30) % 3;
    ctx.save();
    ctx.globalAlpha = 0.75;
    ctx.fillStyle = '#fff';
    ctx.font = `bold ${10 + phase * 2}px Courier New`;
    ctx.textAlign = 'center';
    ctx.fillText('z'.repeat(phase + 1), x + e.w / 2 - 8 - phase * 4, ey - 16 - phase * 4);
    ctx.restore();
  }
}

function drawPlayer() {
  if (!player) return;
  if (player.invincible > 0 && Math.floor(player.invincible / 4) % 2 === 0) return;
  const px = player.x - camera.x, py = player.y;
  const PW = player.w, PH = player.h;
  const f = player.facing;

  ctx.save();
  if (f === -1) { ctx.translate(px + PW, py); ctx.scale(-1, 1); } else { ctx.translate(px, py); }

  ctx.fillStyle = 'rgba(0,0,0,0.18)';
  ctx.beginPath(); ctx.ellipse(PW / 2, PH + 4, PW / 2, 4, 0, 0, Math.PI * 2); ctx.fill();

  /* bushy squirrel tail */
  ctx.fillStyle = '#8B5E3C';
  ctx.beginPath(); ctx.ellipse(-7, PH - 12, 12, 9, -0.5, 0, Math.PI * 2); ctx.fill();
  ctx.fillStyle = '#c4956a';
  ctx.beginPath(); ctx.ellipse(-9, PH - 12, 8, 6, -0.5, 0, Math.PI * 2); ctx.fill();
  ctx.fillStyle = '#e8d5c4';
  ctx.beginPath(); ctx.ellipse(-11, PH - 12, 5, 3.5, -0.5, 0, Math.PI * 2); ctx.fill();

  /* legs */
  const legO = player.frame % 2 === 0 ? 3 : -3;
  ctx.fillStyle = '#1a5276';
  ctx.fillRect(3, PH - 12 + legO, 8, 12 - legO);
  ctx.fillRect(PW - 11, PH - 12 - legO, 8, 12 + legO);
  ctx.fillStyle = '#111';
  ctx.fillRect(2, PH - 4 + legO, 10, 5);
  ctx.fillRect(PW - 12, PH - 4 - legO, 10, 5);

  /* white lab coat */
  ctx.fillStyle = '#f0f8ff';
  ctx.beginPath(); ctx.roundRect(1, PH * 0.38, PW - 2, PH * 0.52, 5); ctx.fill();
  ctx.fillStyle = '#d0e8f8';
  ctx.fillRect(PW / 2 - 2, PH * 0.38, 4, PH * 0.28);
  ctx.fillRect(3, PH * 0.38, 7, PH * 0.18); ctx.fillRect(PW - 10, PH * 0.38, 7, PH * 0.18);
  /* stethoscope */
  ctx.strokeStyle = '#2e86c1'; ctx.lineWidth = 2;
  ctx.beginPath(); ctx.arc(PW * 0.5, PH * 0.56, 5, 0, Math.PI); ctx.stroke();
  ctx.beginPath(); ctx.moveTo(PW * 0.5 - 5, PH * 0.56); ctx.lineTo(PW * 0.5 - 8, PH * 0.72); ctx.stroke();
  ctx.beginPath(); ctx.moveTo(PW * 0.5 + 5, PH * 0.56); ctx.lineTo(PW * 0.5 + 8, PH * 0.72); ctx.stroke();
  ctx.fillStyle = '#2e86c1';
  ctx.beginPath(); ctx.arc(PW * 0.5 - 8, PH * 0.72, 2.5, 0, Math.PI * 2); ctx.fill();
  ctx.beginPath(); ctx.arc(PW * 0.5 + 8, PH * 0.72, 2.5, 0, Math.PI * 2); ctx.fill();
  /* red cross pocket */
  ctx.fillStyle = '#e74c3c';
  ctx.fillRect(PW * 0.65, PH * 0.47, 8, 2); ctx.fillRect(PW * 0.65 + 3, PH * 0.44, 2, 6);

  /* squirrel head */
  ctx.fillStyle = '#8B5E3C';
  ctx.beginPath(); ctx.roundRect(0, 0, PW, PH * 0.42, [8, 8, 4, 4]); ctx.fill();
  ctx.fillStyle = '#8B5E3C';
  ctx.beginPath(); ctx.moveTo(2, 6); ctx.lineTo(-5, -10); ctx.lineTo(12, 2); ctx.closePath(); ctx.fill();
  ctx.beginPath(); ctx.moveTo(PW - 2, 6); ctx.lineTo(PW + 5, -10); ctx.lineTo(PW - 12, 2); ctx.closePath(); ctx.fill();
  ctx.fillStyle = '#c4956a';
  ctx.beginPath(); ctx.moveTo(3, 5); ctx.lineTo(-2, -6); ctx.lineTo(10, 3); ctx.closePath(); ctx.fill();
  ctx.beginPath(); ctx.moveTo(PW - 3, 5); ctx.lineTo(PW + 2, -6); ctx.lineTo(PW - 10, 3); ctx.closePath(); ctx.fill();
  ctx.fillStyle = '#c4956a';
  ctx.beginPath(); ctx.ellipse(PW / 2, PH * 0.28, PW * 0.3, PH * 0.17, 0, 0, Math.PI * 2); ctx.fill();
  /* doctor headband mirror */
  ctx.fillStyle = '#d4d4d4'; ctx.fillRect(-1, -2, PW + 2, 4);
  ctx.fillStyle = 'rgba(200,230,255,0.65)';
  ctx.beginPath(); ctx.arc(PW * 0.5, 0, 5, 0, Math.PI * 2); ctx.fill();
  ctx.strokeStyle = 'rgba(0,100,180,0.5)'; ctx.lineWidth = 1;
  ctx.beginPath(); ctx.arc(PW * 0.5, 0, 5, 0, Math.PI * 2); ctx.stroke();
  /* eyes */
  ctx.fillStyle = '#1a1a1a';
  ctx.beginPath(); ctx.arc(PW * 0.3, PH * 0.2, 2.5, 0, Math.PI * 2); ctx.fill();
  ctx.beginPath(); ctx.arc(PW * 0.7, PH * 0.2, 2.5, 0, Math.PI * 2); ctx.fill();
  ctx.fillStyle = '#fff';
  ctx.beginPath(); ctx.arc(PW * 0.3 + 1, PH * 0.2 - 1, 1, 0, Math.PI * 2); ctx.fill();
  ctx.beginPath(); ctx.arc(PW * 0.7 + 1, PH * 0.2 - 1, 1, 0, Math.PI * 2); ctx.fill();
  ctx.fillStyle = '#2c1a0a';
  ctx.beginPath(); ctx.arc(PW / 2, PH * 0.3, 2, 0, Math.PI * 2); ctx.fill();

  /* syringe in hand */
  if (ammo > 0) {
    ctx.save();
    ctx.translate(PW + 2, PH * 0.5);
    ctx.rotate(-0.3);
    ctx.fillStyle = 'rgba(200,235,255,0.9)';
    ctx.fillRect(0, -3, 14, 6);
    ctx.fillStyle = 'rgba(150,210,255,0.7)';
    ctx.fillRect(1, -2, 9, 4);
    ctx.fillStyle = '#aad4f5';
    ctx.fillRect(14, -1, 5, 2);
    ctx.restore();
  }

  ctx.restore();
}

function drawGoalFlag() {
  if (!player) return;
  const x = player.goalX - camera.x;
  const gY = canvas.height - 40;
  if (x < -40 || x > canvas.width + 60) return;
  ctx.fillStyle = '#aaa'; ctx.fillRect(x, gY - 90, 4, 90);
  ctx.fillStyle = '#7ecfff';
  ctx.beginPath(); ctx.moveTo(x + 4, gY - 90); ctx.lineTo(x + 38, gY - 76); ctx.lineTo(x + 4, gY - 62); ctx.fill();
  ctx.fillStyle = '#fff';
  ctx.font = 'bold 10px Courier New'; ctx.textAlign = 'center';
  ctx.fillText('SALA OP.', x + 2, gY - 98);
}

function drawParticles() {
  particles.forEach(p => {
    ctx.save();
    ctx.globalAlpha = Math.max(0, p.life);
    if (p.isZzz) {
      ctx.fillStyle = p.color;
      ctx.font = `bold ${Math.max(1, p.size)}px Courier New`;
      ctx.textAlign = 'center';
      ctx.fillText(p.letter, p.x - camera.x, p.y);
    } else {
      ctx.fillStyle = p.color;
      ctx.shadowColor = p.color; ctx.shadowBlur = 6;
      ctx.beginPath(); ctx.arc(p.x - camera.x, p.y, Math.max(0.1, p.size), 0, Math.PI * 2); ctx.fill();
    }
    ctx.restore();
  });
}

function drawLevelClear() {
  if (!player || !player.reached) return;
  ctx.save();
  ctx.fillStyle = 'rgba(126,207,255,0.1)'; ctx.fillRect(0, 0, canvas.width, canvas.height);
  ctx.fillStyle = '#7ecfff'; ctx.font = 'bold 24px Courier New'; ctx.textAlign = 'center';
  ctx.shadowColor = '#7ecfff'; ctx.shadowBlur = 20;
  ctx.fillText('✔ NÍVEL COMPLETO!', canvas.width / 2, canvas.height / 2);
  ctx.restore();
}

let raf;
function loop() {
  if (gameState !== 'playing') return;
  ctx.clearRect(0, 0, canvas.width, canvas.height);
  drawBackground();
  drawPlatforms();
  drawGoalFlag();
  syringes.forEach(drawSyringe);
  enemies.forEach(drawEnemy);
  drawBullets();
  drawPlayer();
  drawParticles();
  drawLevelClear();
  updatePlayer();
  updateEnemies();
  updateBullets();
  updateParticles();
  raf = requestAnimationFrame(loop);
}

function startGame() {
  score = 0; lives = 3; level = 1; ammo = 5;
  updateHUD();
  document.getElementById('overlay').style.display = 'none';
  gameState = 'playing';
  resize(); initLevel();
  cancelAnimationFrame(raf);
  loop();
}

function setupControls() {
  const down = { 'btn-left':()=>keys.left=true, 'btn-right':()=>keys.right=true, 'btn-jump':()=>keys.jump=true, 'btn-shoot':()=>keys.shoot=true };
  const up   = { 'btn-left':()=>keys.left=false,'btn-right':()=>keys.right=false,'btn-jump':()=>keys.jump=false,'btn-shoot':()=>keys.shoot=false };
  Object.keys(down).forEach(id => {
    const el = document.getElementById(id);
    const on = () => el.classList.add('pressed'), off = () => el.classList.remove('pressed');
    el.addEventListener('touchstart', e => { e.preventDefault(); down[id](); on(); }, { passive: false });
    el.addEventListener('touchend',   e => { e.preventDefault(); up[id](); off(); }, { passive: false });
    el.addEventListener('touchcancel',e => { e.preventDefault(); up[id](); off(); }, { passive: false });
    el.addEventListener('mousedown', () => { down[id](); on(); });
    el.addEventListener('mouseup',   () => { up[id](); off(); });
    el.addEventListener('mouseleave',() => { up[id](); off(); });
  });
}
setupControls();

window.addEventListener('keydown', e => {
  if (e.key === 'ArrowLeft'  || e.key === 'a') keys.left = true;
  if (e.key === 'ArrowRight' || e.key === 'd') keys.right = true;
  if (e.key === ' ' || e.key === 'ArrowUp' || e.key === 'w') keys.jump = true;
  if (e.key === 'x' || e.key === 'z' || e.key === 'ArrowDown') keys.shoot = true;
});
window.addEventListener('keyup', e => {
  if (e.key === 'ArrowLeft'  || e.key === 'a') keys.left = false;
  if (e.key === 'ArrowRight' || e.key === 'd') keys.right = false;
  if (e.key === ' ' || e.key === 'ArrowUp' || e.key === 'w') keys.jump = false;
  if (e.key === 'x' || e.key === 'z' || e.key === 'ArrowDown') keys.shoot = false;
});

document.addEventListener('touchmove', e => e.preventDefault(), { passive: false });
</script>

